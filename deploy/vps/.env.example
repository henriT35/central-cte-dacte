# Domínio já apontado para o IP público da VPS, sem http:// ou https://
CENTRAL_CTE_DOMAIN=central.seudominio.com.br
LETSENCRYPT_EMAIL=seu-email@seudominio.com.br

# Identificação da imagem
CENTRAL_CTE_IMAGE=central-cte-dacte:r12.13.9

# Segurança interna entre Caddy e aplicação.
# Gere valores fortes com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CENTRAL_CTE_METRICS_TOKEN=troque-por-um-token-longo-e-aleatorio

# Limites de recursos do contêiner da aplicação.
CENTRAL_CTE_MEMORY_LIMIT=4g
CENTRAL_CTE_CPU_LIMIT=2.0

# Backup automático local.
CENTRAL_CTE_BACKUP_INTERVAL_SECONDS=86400
CENTRAL_CTE_BACKUP_RETENTION_COUNT=14
CENTRAL_CTE_BACKUP_RUN_ON_START=1

# Backup externo S3 compatível (opcional). Deixe S3_BUCKET vazio para desativar.
S3_BUCKET=
S3_PREFIX=central-cte
S3_ENDPOINT_URL=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Opcional: AES256 ou aws:kms. Para KMS, informe também a chave.
S3_SERVER_SIDE_ENCRYPTION=
S3_KMS_KEY_ID=

# Monitoramento e alerta (opcional). Aceita webhook HTTP que receba JSON.
ALERT_WEBHOOK_URL=
MONITOR_INTERVAL_SECONDS=60
MONITOR_FAILURE_THRESHOLD=3

# Integração PostgreSQL SSW R12.13 (somente leitura / modo sombra).
# Na VPS, mantenha DIRECT_ENABLED=0 enquanto 192.168.0.247 só existir na LAN da empresa.
CENTRAL_CTE_SSW_PG_DIRECT_ENABLED=0
CENTRAL_CTE_SSW_PG_HOST=
CENTRAL_CTE_SSW_PG_PORT=5432
CENTRAL_CTE_SSW_PG_DBNAME=
CENTRAL_CTE_SSW_PG_USER=
CENTRAL_CTE_SSW_PG_PASSWORD=
CENTRAL_CTE_SSW_PG_SSLMODE=prefer
CENTRAL_CTE_SSW_PG_SCHEMA=staging
CENTRAL_CTE_SSW_PG_TABLE=stg_ssw_455_fretes
CENTRAL_CTE_SSW_PG_CONNECT_TIMEOUT=6
