# ============================================================
# CENTRAL CT-e / DACTE - VPS
# ============================================================
# Modos suportados:
#   ip     -> acesso temporário por http://IP_DA_VPS:8765
#   domain -> acesso recomendado por https://SEU_DOMINIO (Caddy)
CENTRAL_CTE_DEPLOY_MODE=ip

# ------------------------------------------------------------
# MODO IP + PORTA (usado quando DEPLOY_MODE=ip)
# ------------------------------------------------------------
CENTRAL_CTE_PUBLIC_PORT=8765
CENTRAL_CTE_BIND_ADDRESS=0.0.0.0

# Opcional. Se souber o IP público, informe para o script mostrar a URL exata.
# Exemplo: CENTRAL_CTE_PUBLIC_HOST=179.198.105.241
CENTRAL_CTE_PUBLIC_HOST=

# Host header permitido no modo IP. "*" aceita o IP público da VPS.
# Quando souber o IP definitivo, pode trocar por: IP_DA_VPS,localhost,127.0.0.1
CENTRAL_CTE_ALLOWED_HOSTS=*

# ------------------------------------------------------------
# MODO DOMÍNIO + HTTPS (usado somente quando DEPLOY_MODE=domain)
# ------------------------------------------------------------
# Sem http:// e sem https://
CENTRAL_CTE_DOMAIN=
LETSENCRYPT_EMAIL=

# Identificação da imagem
CENTRAL_CTE_IMAGE=central-cte-dacte:r12.13.9

# Token interno de métricas.
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
CENTRAL_CTE_METRICS_TOKEN=troque-por-um-token-longo-e-aleatorio

# Limites de recursos do contêiner da aplicação.
CENTRAL_CTE_MEMORY_LIMIT=4g
CENTRAL_CTE_CPU_LIMIT=2.0

# Backup automático local.
CENTRAL_CTE_BACKUP_INTERVAL_SECONDS=86400
CENTRAL_CTE_BACKUP_RETENTION_COUNT=14
CENTRAL_CTE_BACKUP_RUN_ON_START=1

# Backup externo S3 compatível (opcional). Deixe S3_BUCKET vazio para desativar.
S3_BUCKET=
S3_PREFIX=central-cte
S3_ENDPOINT_URL=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_SERVER_SIDE_ENCRYPTION=
S3_KMS_KEY_ID=

# Monitoramento e alerta (opcional).
ALERT_WEBHOOK_URL=
MONITOR_INTERVAL_SECONDS=60
MONITOR_FAILURE_THRESHOLD=3

# Integração PostgreSQL SSW R12.13 (somente leitura / modo sombra).
CENTRAL_CTE_SSW_PG_DIRECT_ENABLED=0
CENTRAL_CTE_SSW_PG_HOST=
CENTRAL_CTE_SSW_PG_PORT=5432
CENTRAL_CTE_SSW_PG_DBNAME=
CENTRAL_CTE_SSW_PG_USER=
CENTRAL_CTE_SSW_PG_PASSWORD=
CENTRAL_CTE_SSW_PG_SSLMODE=prefer
CENTRAL_CTE_SSW_PG_SCHEMA=staging
CENTRAL_CTE_SSW_PG_TABLE=stg_ssw_455_fretes
CENTRAL_CTE_SSW_PG_CONNECT_TIMEOUT=6
